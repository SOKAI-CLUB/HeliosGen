# ── Quick start (guest mode) ──────────────────────────────────────────────────
# Set GUEST_MODE=true to run without Supabase or R2 — see .env.guest for details.
# Data is saved to data/guest-db.json; media is saved to public/generated/.
GUEST_MODE=
# Client-side mirror used to disable cloud-only UI paths in guest mode.
NEXT_PUBLIC_GUEST_MODE=
# Default server-side Kie.ai key shared by every account. Users can override it
# with a personal key from Settings (also used as the fallback in guest mode).
KIE_API_KEY=

# ── Demo mode ─────────────────────────────────────────────────────────────────
# Set NEXT_PUBLIC_DEMO_MODE=true to replace the sign-in modal with a
# prompt pointing visitors to the GitHub repo to self-host.
NEXT_PUBLIC_DEMO_MODE=

# ── Kie.ai ────────────────────────────────────────────────────────────────────
# KIE_API_KEY above is server-only. It is used unless a user saves a personal key.

# Public URL where kie.ai POSTs job completion results (webhook).
# Must be reachable from the internet.
# Local dev: use ngrok → ngrok http 3000
# Production: your deployed domain, e.g. https://your-app.vercel.app
CALLBACK_BASE_URL=

# ── Supabase ──────────────────────────────────────────────────────────────────
# Settings → API in your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Data API schema. The recommended setup uses a dedicated Supabase project.
NEXT_PUBLIC_SUPABASE_SCHEMA=public

# Legacy aliases are still accepted during migration:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# Account ID: Cloudflare dashboard sidebar
R2_ACCOUNT_ID=
# API token: R2 → Manage R2 API Tokens → Create API Token (Object Read & Write)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public CDN URL — enable public access on the bucket first
R2_PUBLIC_URL=

# ── Azure OpenAI (optional) ───────────────────────────────────────────────────
# Only needed if routing models through Azure AI Foundry instead of Kie.ai
AZURE_API_KEY=
